#!/bin/sh
# Format staged Rust files with rustfmt before committing.
#
# Enable with: git config core.hooksPath .githooks

set -e

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
[ -z "$files" ] && exit 0

# Re-staging a file that also has unstaged changes would sneak those changes
# into the commit, so only check those files instead of formatting them.
partial=""
for f in $files; do
  git diff --quiet -- "$f" || partial="$partial $f"
done

edition=$(sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' Cargo.toml)

if [ -n "$partial" ]; then
  if ! rustfmt --edition "$edition" --check $partial >/dev/null; then
    echo "pre-commit: these files are partially staged and not formatted:" >&2
    for f in $partial; do echo "  $f" >&2; done
    echo "Run 'cargo fmt', stage the result and commit again." >&2
    exit 1
  fi
fi

rustfmt --edition "$edition" $files
git add $files
